# Required: a strong password that grants access to the app (minimum 12 characters).
# No default is provided — the server refuses to start without one.
APP_PASSWORD=change-me-to-a-long-secret

# deployment environment: "production" sets the Secure flag on the session cookie.
# Leave unset for local development / LAN over plain HTTP. Production must run behind HTTPS.
APP_ENV=production

# Optional: recovery key that unlocks the "Forgot password?" reset on the login
# screen. Set this to a long secret; leave empty to disable password reset.
# RESET_KEY=change-me-to-a-long-secret

# Optional overrides.
# PORT=8080
# SQLITE_DB_PATH=/app/data/budget.db
